{% extends 'base.html.twig' %}

{% block title %}Books List{% endblock %}

{% block body %}
<div style="text-align: center;">
    <h1>List of Books</h1>

    {% if publishedBooks is not empty %}
        <table border="1" cellpadding="10" style="margin: 20px auto; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #f0f0f0;">
                    <th>Title</th>
                    <th>Publication date</th>
                    <th>Published</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for book in publishedBooks %}
                    <tr>
                        <td>{{ book.title }}</td>
                        <td>{{ book.publicationDate|date('F j, Y H:i') }}</td>
                        <td>{{ book.published ? '1' : '0' }}</td>
                        <td>{{ book.category  }}</td>
                        <td>{{ book.author.name }}</td>
                        <td>
                            <a href="{{ path('app_book_edit', {'id': book.id}) }}" style="color: blue; text-decoration: underline;">edit</a>
                            <a href="{{ path('app_book_delete', {'id': book.id}) }}" 
                               style="color: red; text-decoration: underline;">delete</a>  
                            <a href="{{ path('app_book_detail',{'id': book.id}) }}" 
                               style="color: green; text-decoration: underline;">detail</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p>No published books found.</p>
    {% endif %}

    <div style="margin: 30px 0;">
        <p><strong>Number of published books : {{ publishedCount }}</strong></p>
        <p><strong>Number of unpublished books : {{ unpublishedCount }}</strong></p>
    </div>

    <a href="{{ path('app_book_add') }}" class="btn btn-primary" style="text-decoration: none; padding: 10px 20px; background-color: #007bff; color: white; border-radius: 5px;">Create new</a>
</div>
{% endblock %}